{"id": "fengshui-feixing-187-yun8", "cmd": ["fengshui", "feixing", "--facing", "187", "--yun", "8", "--json"], "expect": {"result.sub": "feixing", "result.shan": "子", "result.xiang": "午", "result.yun": 8, "result.pattern": "双星到向", "result.shan_ruzhong": 4, "result.xiang_ruzhong": 3}, "status": "rule-verified", "note": "沈氏玄空：八运子午为双星到向；兼向 7° 已发 JIAN_XIANG"}
